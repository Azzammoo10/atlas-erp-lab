# Fictitious local values only. Copy to .env; choose your own password.
POSTGRES_DB=atlas_lab
POSTGRES_USER=atlas_lab
POSTGRES_PASSWORD=example-only-change-me
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=8081
# Local backend (Compose sets its own internal host/port):
DB_URL=jdbc:postgresql://localhost:5432/atlas_lab
DB_USERNAME=atlas_lab
DB_PASSWORD=example-only-change-me
# Vite development proxy; never included in the browser bundle.
API_PROXY_TARGET=http://localhost:8080
